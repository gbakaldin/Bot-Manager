<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mercury</groupId>
    <artifactId>Bot</artifactId>
    <version>1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>bot-strategies</artifactId>
  <name>Bot - Strategies</name>
  <description>
    Concrete betting/slot strategy implementations (martingale family, random /
    weighted behaviour, slot bet strategies). Depends only on bot-api (contract
    module) and framework libraries. The discovery factories that resolve these
    beans by key (BettingStrategyFactory / SlotStrategyFactory) live in bot-engine
    since PLUGIN_HOT_RELOAD_3_4 Phase 3a.
  </description>

  <dependencies>
    <!-- Everything below except the test dependencies is PROVIDED
         (PLUGIN_HOT_RELOAD_3_4 D-6): the contract layer and the frameworks are
         supplied by the engine that loads the plugin, so a plugin jar never carries
         or transitively pulls them. bot-api's own compile dependencies (Jackson
         databind, websocket-parser, spring-data-mongodb for @Document Game) become
         provided with it - harmless, and not to be "fixed" by bundling. Do not add
         a compile-scope dependency here, and no Micrometer at any scope (L-9). -->
    <dependency>
      <groupId>com.mercury</groupId>
      <artifactId>bot-api</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- @Component / @Scope("prototype") on the strategy beans. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- @Slf4j on the strategies. Was inherited from bot-api; declared now that
         bot-api is provided and the dependency is part of the plugin contract. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- WeightedOptionPickerTest attaches a log4j2 appender; log4j2 must be the
         active SLF4J binding on the test classpath (mirrors bot-app runtime). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-log4j2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <!-- The root pom binds the plugin-boundary enforcer in every module; a ban on
           the plugin modules is meaningless inside a plugin module itself. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <!-- Bot-Plugin-Version / Bot-Plugin-Name (PLUGIN_HOT_RELOAD_3_4 D-7): the
           bundle loader (step 4) reads the version from here, never from the
           directory name or the Maven version. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- Re-archive on every build. Without it the jar's up-to-date check
               skips a module whose classes did not change, its manifest keeps the
               previous session's stamp, and one plugin module edited + `mvn package`
               without `clean` yields a bundle whose two jars disagree (review-3b,
               qa-3b F1) - which D-7 defines as invalid. -->
          <forceCreation>true</forceCreation>
          <archive>
            <manifestEntries>
              <Bot-Plugin-Version>${bot.plugin.version}</Bot-Plugin-Version>
              <Bot-Plugin-Name>${project.artifactId}</Bot-Plugin-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
