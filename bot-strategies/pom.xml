<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mercury</groupId>
    <artifactId>Bot</artifactId>
    <version>1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>bot-strategies</artifactId>
  <name>Bot - Strategies</name>
  <description>
    Concrete betting/slot strategy implementations (martingale family, random /
    weighted behaviour, slot bet strategies). Depends only on bot-api (contract
    module) and framework libraries. The discovery factories that resolve these
    beans by key (BettingStrategyFactory / SlotStrategyFactory) live in bot-engine
    since PLUGIN_HOT_RELOAD_3_4 Phase 3a.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.mercury</groupId>
      <artifactId>bot-api</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- @Component / @Scope("prototype") on the strategy beans. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- WeightedOptionPickerTest attaches a log4j2 appender; log4j2 must be the
         active SLF4J binding on the test classpath (mirrors bot-app runtime). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-log4j2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
