<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.0</version>
    <relativePath/>
  </parent>

  <groupId>com.mercury</groupId>
  <artifactId>Bot</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>
  <name>Archetype - Bot</name>
  <url>https://maven.apache.org</url>

  <modules>
    <module>bot-api</module>
    <module>bot-strategies</module>
    <module>bot-messages</module>
    <module>bot-engine</module>
    <module>bot-app</module>
  </modules>

  <repositories>
    <repository>
      <id>gb-libs-release-local</id>
      <url>https://artifactory.facilities.vip/artifactory/gb-libs-release-local</url>
    </repository>
  </repositories>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mapstruct.version>1.6.3</mapstruct.version>
    <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
    <lombok.version>1.18.34</lombok.version>
    <netty.version>4.2.9.Final</netty.version>
    <jackson.databind.version>2.15.2</jackson.databind.version>
    <jackson.core.version>2.15.2</jackson.core.version>
    <jackson.annotations.version>2.20</jackson.annotations.version>
    <springdoc.version>2.7.0</springdoc.version>
    <websocket-parser.version>3.0.5</websocket-parser.version>

    <!-- Plugin bundle version (PLUGIN_HOT_RELOAD_3_4 D-7), stamped into each plugin
         jar's manifest as Bot-Plugin-Version. maven.build.timestamp is fixed once per
         reactor session and is UTC, so bot-strategies and bot-messages built together
         carry the same value - that shared value IS the bundle version, and a bundle
         whose jars disagree is invalid. The format sorts lexicographically, so "newer"
         is a string comparison. The Maven version (1.0 everywhere) carries no
         information and is not used. Building one plugin module on its own
         (`-pl bot-messages`) produces a different value, i.e. a different bundle. -->
    <maven.build.timestamp.format>yyyyMMdd.HHmmss</maven.build.timestamp.format>
    <bot.plugin.version>${maven.build.timestamp}</bot.plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.vingame</groupId>
        <artifactId>websocket-parser-core</artifactId>
        <version>${websocket-parser.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-reload4j</artifactId>
          </exclusion>
        </exclusions>
      </dependency>

      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-all</artifactId>
        <version>${netty.version}</version>
      </dependency>

      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.databind.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>${jackson.core.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>${jackson.annotations.version}</version>
      </dependency>

      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>

      <dependency>
        <groupId>org.mapstruct</groupId>
        <artifactId>mapstruct</artifactId>
        <version>${mapstruct.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- The engine/plugin boundary (PLUGIN_HOT_RELOAD_3_4 D-6). Declared (bound,
             with no further configuration) in bot-api, bot-engine and bot-app - the
             modules that must never compile against a plugin module. The scopes in
             those poms are what make a concrete plugin class a compiler error; this
             rule is what stops someone "fixing" that error by widening the scope back
             to compile/provided. Pattern format:
             groupId:artifactId:version:type:scope. Transitive paths are searched too,
             so a plugin module cannot arrive at compile scope through another module
             either. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <executions>
            <execution>
              <id>ban-plugin-modules-on-compile-classpath</id>
              <goals>
                <goal>enforce</goal>
              </goals>
              <configuration>
                <rules>
                  <bannedDependencies>
                    <excludes>
                      <exclude>com.mercury:bot-strategies:*:*:compile</exclude>
                      <exclude>com.mercury:bot-strategies:*:*:provided</exclude>
                      <exclude>com.mercury:bot-messages:*:*:compile</exclude>
                      <exclude>com.mercury:bot-messages:*:*:provided</exclude>
                    </excludes>
                    <message>A plugin module (bot-strategies / bot-messages) is on this module's compile classpath. Engine and app code must not compile against plugin classes: bot-engine takes them at test scope, bot-app at runtime scope (PLUGIN_HOT_RELOAD_3_4 D-6). Move the class you need to the side the D-2 rule puts it on instead of widening the scope.</message>
                  </bannedDependencies>
                </rules>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.11.0</version>
          <configuration>
            <source>21</source>
            <target>21</target>
            <annotationProcessorPaths>
              <path>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
              </path>
              <path>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok-mapstruct-binding</artifactId>
                <version>${lombok-mapstruct-binding.version}</version>
              </path>
            </annotationProcessorPaths>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
