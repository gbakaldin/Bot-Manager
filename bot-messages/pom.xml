<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mercury</groupId>
    <artifactId>Bot</artifactId>
    <version>1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>bot-messages</artifactId>
  <name>Bot - Messages</name>
  <description>
    Concrete per-brand message implementations (g2/{bom,b52}, g3/tip, g4/nohu,
    slot, taixiu), the request builders (Request / SlotRequest / TaiXiuRequest and
    friends), and the MessageTypesRegistry that maps a game type / product-code
    string onto the correct concrete provider. The message interfaces and
    abstract base messages live in bot-api (Phase 2); this module holds only the
    concrete Jackson-polymorphic subtypes referenced by that contract. Depends only
    on bot-api and Jackson/Lombok. One module for all brands (Architecture
    Decision #4).
  </description>

  <dependencies>
    <dependency>
      <groupId>com.mercury</groupId>
      <artifactId>bot-api</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Jackson polymorphism annotations on the concrete message classes.
         jackson-databind (used by the registry round-trip tests) is inherited
         transitively from bot-api. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>

    <!-- @Component on the message-types providers and on MessageTypesRegistry
         (PLUGIN_HOT_RELOAD Phase 2c, AD-18: discovery stays Spring bean
         discovery; ServiceLoader is rejected because the strategies already
         need Spring for prototype instances and two discovery models would be
         worse than either). This is a downward dependency on an external
         library — it introduces no reverse edge in
         bot-app -> bot-engine -> {bot-strategies, bot-messages} -> bot-api. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
