<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mercury</groupId>
    <artifactId>Bot</artifactId>
    <version>1.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>bot-messages</artifactId>
  <name>Bot - Messages</name>
  <description>
    Concrete per-brand message implementations (g2/{bom,b52}, g3/{rik,tip},
    g4/{nohu,win79}, slot, taixiu) and the per-brand RIK request bodies. The
    message interfaces, abstract base messages and product-neutral request frames
    live in bot-api, and the MessageTypesRegistry that maps a game type /
    product-code string onto a provider lives in bot-engine (PLUGIN_HOT_RELOAD_3_4
    Phase 3a); this module holds only the concrete Jackson-polymorphic subtypes
    referenced by that contract. Depends only
    on bot-api and Jackson/Lombok. One module for all brands (Architecture
    Decision #4).
  </description>

  <dependencies>
    <!-- Everything below except the test dependencies is PROVIDED
         (PLUGIN_HOT_RELOAD_3_4 D-6): the contract layer and the frameworks are
         supplied by the engine that loads the plugin, so a plugin jar never carries
         or transitively pulls them. bot-api's own compile dependencies (Jackson
         databind, websocket-parser, spring-data-mongodb for @Document Game) become
         provided with it - harmless, and not to be "fixed" by bundling. Do not add
         a compile-scope dependency here, and no Micrometer at any scope (L-9). -->
    <dependency>
      <groupId>com.mercury</groupId>
      <artifactId>bot-api</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Jackson polymorphism annotations on the concrete message classes.
         jackson-databind is inherited transitively from bot-api. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- ActionRequestMessage / Body on the RIK request bodies. Was inherited from
         bot-api; declared now that bot-api is provided. -->
    <dependency>
      <groupId>com.vingame</groupId>
      <artifactId>websocket-parser-core</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- @Component on the message-types providers
         (PLUGIN_HOT_RELOAD Phase 2c, AD-18: discovery stays Spring bean
         discovery; ServiceLoader is rejected because the strategies already
         need Spring for prototype instances and two discovery models would be
         worse than either). This is a downward dependency on an external
         library — it introduces no reverse edge in
         bot-app -> bot-engine -> {bot-strategies, bot-messages} -> bot-api. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <!-- Bot-Plugin-Version / Bot-Plugin-Name (PLUGIN_HOT_RELOAD_3_4 D-7): the
           bundle loader (step 4) reads the version from here, never from the
           directory name or the Maven version. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- Re-archive on every build. Without it the jar's up-to-date check
               skips a module whose classes did not change, its manifest keeps the
               previous session's stamp, and one plugin module edited + `mvn package`
               without `clean` yields a bundle whose two jars disagree (review-3b,
               qa-3b F1) - which D-7 defines as invalid. -->
          <forceCreation>true</forceCreation>
          <archive>
            <manifestEntries>
              <Bot-Plugin-Version>${bot.plugin.version}</Bot-Plugin-Version>
              <Bot-Plugin-Name>${project.artifactId}</Bot-Plugin-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
