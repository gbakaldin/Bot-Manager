{
  "uid": "per-environment",
  "title": "Per-Environment",
  "tags": [
    "bot-manager",
    "observability",
    "per-environment"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "timezone": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "refresh": "30s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(environment_join, environmentName)",
        "query": {
          "qryType": 1,
          "query": "label_values(environment_join, environmentName)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {},
        "options": [],
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "environmentId",
        "label": "Environment ID (resolved)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(environment_join{environmentName=\"$environment\"}, environmentId)",
        "query": {
          "qryType": 1,
          "query": "label_values(environment_join{environmentName=\"$environment\"}, environmentId)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 2,
        "current": {},
        "options": [],
        "regex": "",
        "skipUrlSync": false
      }
    ]
