# Host-local secrets / per-instance overrides for docker-compose.
#
# Copy to `secrets.env` ON THE HOST (Bot-1, prod box, …) and fill in. Never commit
# the real file — `secrets.env` is gitignored; this `.example` is the committed
# template.
#
#   cp secrets.env.example secrets.env && vi secrets.env && ./deploy.sh
#
# deploy.sh appends this file to the .env it generates, so docker-compose
# interpolates the values into the bot-manager container's environment. It lives
# here rather than in .env directly because deploy.sh REWRITES .env on every run.
#
# Absent file ⇒ the defaults in docker-compose.yml apply (alerting disabled), so a
# host without it deploys exactly as before.

# --- VipTalk alerting (docs/plans/VIPTALK_ALERTING.md) ---

# Master switch, for BOTH delivery paths — the app and the viptalk-shim container.
# Leave false until the bot token and at least one room are set; setting it false
# later mutes everything, including the out-of-band app-down notice.
VIPTALK_ENABLED=false

# Bot token from the VipTalk bot registration. Goes in the API URL path.
# Enabled with a blank token ⇒ the app logs ERROR and self-disables (AD-3).
VIPTALK_BOT_TOKEN=

# Room for `audience: internal` alerts — fundamental infrastructure only (host
# CPU / RAM / storage, BotManagerDown, JVM threads). It also receives, tagged as
# misrouted, any product-scoped alert whose product has no room wired yet
# (VIPTALK_ALERTING_V2 AD-V5). Blank ⇒ those are dropped with a WARN.
# Matrix room ID, e.g. !aBcDeF:matrix-uat.viptalk.org
VIPTALK_OPS_ROOM_ID=

# Stamped into every message header. prod / loadtest / staging run the same
# artifact into the same rooms, so this is what tells them apart — and it is the
# ONLY thing that does. Fill it in on every host: left blank, the header simply
# carries no instance segment and the app logs a WARN at startup. Nothing
# defaults it for you, because a wrong label is worse than a missing one.
#   prod | loadtest | staging
VIPTALK_INSTANCE_LABEL=

# Whether `audience: both` alerts also reach the product room in a non-technical,
# customer-facing register (AD-V7). PROD ONLY — on staging or loadtest this would
# announce "the application is experiencing issues" to a live product room on
# every restart. Governs BOTH paths: false here also stops the shim's customer
# register, so this flag is the single answer to "can a product room hear from us".
VIPTALK_CUSTOMER_NOTICES_ENABLED=false

# --- Out-of-band app-down delivery (VIPTALK_ALERTING_V2 Phase 6 / AD-V8b) ---
#
# Read by the `viptalk-shim` container, NOT by the app. BotManagerDown fires exactly
# when bot-manager cannot forward alerts, so that one message is delivered by a
# separate container that Alertmanager webhooks directly. The shim reuses
# VIPTALK_ENABLED, VIPTALK_CUSTOMER_NOTICES_ENABLED, VIPTALK_BOT_TOKEN,
# VIPTALK_OPS_ROOM_ID and VIPTALK_INSTANCE_LABEL from above — same values, same
# meaning, so there is no second set of switches to keep in step.

# Product rooms that receive the outage notice in the customer register, in the
# same non-technical wording as BotManagerDown's `public_summary`. Space- or
# comma-separated Matrix room IDs.
#
# PROD ONLY — leave blank on staging/loadtest (AD-V7): otherwise every restart of a
# non-prod instance announces "the application is experiencing issues" to a live
# product room. Blank does NOT disable the shim; the ops room still gets the
# technical register, correctly labelled with VIPTALK_INSTANCE_LABEL.
VIPTALK_DOWN_ROOM_IDS=

# Optional wording overrides for the shim's two fixed texts. Blank ⇒ the built-in
# copy compiled into viptalk-shim/shim.py. VIPTALK_DOWN_TEXT is customer-facing and
# is kept byte-identical to BotManagerDown's `public_summary` in
# prometheus/alerts.yml — change both together, or the same outage reads two
# different ways depending on which path delivered it.
VIPTALK_DOWN_TEXT=
VIPTALK_DOWN_OPS_TEXT=

# Recovery copy published to a product room when an `audience: both` alert RESOLVES
# and the rule declares no `public_resolved_summary` annotation. Blank/unset ⇒ the
# built-in default (see application.properties) — it is never the firing wording.
# Product-facing: agree it with whoever owns the room before the first prod send.
VIPTALK_PUBLIC_RESOLVED_SUMMARY=

# ---------------------------------------------------------------------------
# Default log level for com.vingame.bot (LOG_VOLUME_TIERING AD-7)
# ---------------------------------------------------------------------------
# Not a secret — it lives here because secrets.env is the only per-host file that
# survives deploy.sh regenerating .env on every run. Compose reads it as
# LOGGING_LEVEL_COM_VINGAME_BOT=${BOT_LOG_LEVEL:-INFO}.
#
# Unset/blank ⇒ INFO, the shipped default. INFO carries the group-lifecycle lines
# and the 5-minute fleet rollup, and nothing whose rate is a function of bot count
# or round rate.
#
# STAGING sets DEBUG. PROD must NOT: at ~10 environments x 2–3k bots, DEBUG is on
# the order of 5 GB/hour, which is the shape that filled the disk on 2026-06-30 and
# took Mongo down with it. For a single misbehaving group on prod, wait for Phase 2's
# scoped per-group DEBUG rather than flipping this — and note that
# POST /actuator/loggers/com.vingame.bot is the same global action, not a smaller one.
BOT_LOG_LEVEL=

# ---------------------------------------------------------------------------
# Evidence retention (LOG_VOLUME_TIERING Phase 3, AD-19 / AD-16)
# ---------------------------------------------------------------------------
# Also not secrets — same reason as BOT_LOG_LEVEL: secrets.env is the only
# per-host file that survives deploy.sh regenerating .env on every run.
#
# evidence-shim hardlinks the log files around an incident into logs/evidence/,
# which is outside log4j2's Delete and promtail's scrape. That directory therefore
# needs its own bound, or the fix for unbounded growth becomes unbounded growth.
# The sweep runs on every promotion and hourly: files older than the age limit go
# first, then oldest-first until the total is under the byte limit.
#
# "Older" is measured from the PROMOTION, not from the file's mtime. A hardlink
# shares the source inode, so a promoted file's mtime is the log's last-write time
# and the older of the pinned pair can already be days old when it is pinned —
# sweeping on mtime would have delivered `EVIDENCE_MAX_AGE_DAYS minus its age at
# promotion`, i.e. roughly 7 days against an advertised 14. The shim keeps the
# promotion times in logs/evidence/.promoted.json; delete that file and the ages
# fall back to mtime, which errs early rather than late.
#
# Unset/blank ⇒ 14 days and 5 GB. Sizes are apparent sizes, so a promoted file
# still shares its blocks with the original and the guard OVER-estimates — the
# safe direction. EVIDENCE_MAX_AGE_DAYS=0 means "sweep everything" (that is how
# verification step P3-10 exercises the guard); it is not a way to disable it.
EVIDENCE_MAX_AGE_DAYS=
EVIDENCE_MAX_BYTES=

# How often log4j2 rolls console.log over, in hours. MUST match
# appender.rolling.policies.time.interval in logging/log4j2.properties (2 since
# Phase 0 / AD-20) — the build fails if the two disagree. The shim's third
# promotion pass runs at the next rollover boundary + 120 s, so the file that was
# live when the alert fired is also pinned under its rolled name once it closes.
EVIDENCE_ROLLOVER_HOURS=
